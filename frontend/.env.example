# "dev"    -> backend runs with AUTH_MODE=dev; the login page offers "Continue as dev user"
# "google" -> real Google OAuth (backend Phase 5)
VITE_AUTH_MODE=google

# Leave unset in dev (Vite proxies /api to the backend). Set for a separately hosted API.
# VITE_API_BASE=https://api.example.com/api
# Where the dev proxy forwards /api
# VITE_BACKEND_URL=http://localhost:4000
