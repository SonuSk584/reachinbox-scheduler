# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:5173
# "google" = real Google OAuth login (needs the three GOOGLE_* values below)
# "dev"    = skip login and act as a local dev user (handy while developing)
AUTH_MODE=dev

# --- Google OAuth ---
# From Google Cloud Console > APIs & Services > Credentials > your OAuth client. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed under "Authorized redirect URIs" for that client
GOOGLE_REDIRECT_URI=
SESSION_TTL_DAYS=7
# Set to true when served over HTTPS
COOKIE_SECURE=false

# --- Slack alerts (optional) ---
# From api.slack.com/apps > your app > Basic Information. Never commit real values.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Your public HTTPS address (ngrok http 4000) + /api/slack/callback. Must also be listed under
# "Redirect URLs" in the Slack app's OAuth & Permissions page.
SLACK_REDIRECT_URI=
# Set to true when served over HTTPS
COOKIE_SECURE=false

# --- Infra --- //reachinbox:reachinbox@localhost:3307/reachinbox
DATABASE_URL=
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# --- Worker tuning ---
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender (ms), enforced via Redis.
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Default hourly cap per sender (a batch can override it), enforced via Redis counters.
MAX_EMAILS_PER_HOUR_PER_SENDER=100
JOB_MAX_ATTEMPTS=3s
# A row stuck in "sending" longer than this is considered a crashed send
STALE_SENDING_MINUTES=5
# Park a job as "delayed" instead of sleeping in the worker when its slot is further away than this (ms)
INLINE_WAIT_MAX_MS=10000
# How many hourly windows ahead a job may be booked before it is re-checked an hour later
RATE_LIMIT_HORIZON_HOURS=336
